{
  "$defs": {
    "SpatialUncertainty": {
      "additionalProperties": false,
      "description": "One-sigma positional uncertainty per axis, in meters.",
      "properties": {
        "sigma_x": {
          "minimum": 0.0,
          "title": "Sigma X",
          "type": "number"
        },
        "sigma_y": {
          "minimum": 0.0,
          "title": "Sigma Y",
          "type": "number"
        },
        "sigma_z": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Sigma Z",
          "type": "number"
        }
      },
      "required": [
        "sigma_x",
        "sigma_y"
      ],
      "title": "SpatialUncertainty",
      "type": "object"
    },
    "VisionEvidenceKind": {
      "enum": [
        "PERSON_AT_FIXTURE",
        "REACH_INTO_FIXTURE",
        "ITEM_IN_HAND",
        "ITEM_PLACED"
      ],
      "title": "VisionEvidenceKind",
      "type": "string"
    },
    "WorldCoordinate": {
      "additionalProperties": false,
      "description": "Point in the shared store frame (meters).",
      "properties": {
        "frame_id": {
          "default": "store",
          "title": "Frame Id",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "z": {
          "default": 0.0,
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "WorldCoordinate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Semantic (non-biometric) evidence from a vision provider.\n\n``coordinate`` is the world position of the observed person/interaction.\nVision never identifies people; it only says *something happened here*.",
  "properties": {
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "coordinate": {
      "$ref": "#/$defs/WorldCoordinate"
    },
    "fixture_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fixture Id"
    },
    "kind": {
      "$ref": "#/$defs/VisionEvidenceKind"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "observation_id": {
      "minLength": 1,
      "title": "Observation Id",
      "type": "string"
    },
    "scenario_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scenario Id"
    },
    "sensor_id": {
      "minLength": 1,
      "title": "Sensor Id",
      "type": "string"
    },
    "source_type": {
      "const": "VISION",
      "default": "VISION",
      "title": "Source Type",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "uncertainty": {
      "anyOf": [
        {
          "$ref": "#/$defs/SpatialUncertainty"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "zone_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Zone Id"
    }
  },
  "required": [
    "observation_id",
    "sensor_id",
    "timestamp",
    "confidence",
    "coordinate",
    "kind"
  ],
  "title": "VisionEvidence",
  "type": "object"
}

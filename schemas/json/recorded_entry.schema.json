{
  "$defs": {
    "EntryKind": {
      "enum": [
        "OBSERVATION",
        "RETAIL_EVENT",
        "DECISION",
        "CART_EVENT",
        "GROUND_TRUTH",
        "STORE_TWIN",
        "PIPELINE_CONFIG",
        "CLOCK",
        "DUPLICATE_OBSERVATION",
        "RUN_END"
      ],
      "title": "EntryKind",
      "type": "string"
    },
    "SourceType": {
      "description": "Sensing modality of an observation or sensor.",
      "enum": [
        "MMWAVE",
        "RFID",
        "VISION"
      ],
      "title": "SourceType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "default": 1,
      "description": "Recording format: 1 = Foundation v0 (the default when the field is absent, for legacy data), 2 = adds CLOCK, DUPLICATE_OBSERVATION and RUN_END (what every new writer declares explicitly); other versions are rejected on read",
      "enum": [
        1,
        2
      ],
      "title": "Format Version",
      "type": "integer"
    },
    "kind": {
      "$ref": "#/$defs/EntryKind"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "scenario_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scenario Id"
    },
    "sensor_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sensor Id"
    },
    "sequence": {
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "source_type": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceType"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "timestamp": {
      "description": "Recording position: for input entries the observation timestamp, for a DUPLICATE_OBSERVATION the pipeline clock at rejection, so a recording is always chronological",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    }
  },
  "required": [
    "sequence",
    "timestamp",
    "kind",
    "payload"
  ],
  "title": "RecordedEntry",
  "type": "object"
}

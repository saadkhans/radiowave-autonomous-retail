    },
    "exited_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exited At"
    },
    "person_track_id": {
      "minLength": 1,
